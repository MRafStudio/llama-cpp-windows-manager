    <AssemblyName>LocalLlmConsole.Service</AssemblyName>
    <RootNamespace>LocalLlmConsole.Service</RootNamespace>
    <AssemblyTitle>llama.cpp Server Service</AssemblyTitle>
    <Product>llama.cpp Server Service</Product>
    <Version>2.3.2.8</Version>
